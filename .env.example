# Tushare Token (Optional for basic realtime quotes)
TUSHARE_TOKEN=your_token

# Common stock codes for batch analyze
COMMON_STOCK_CODES=600519

# 本地通知监听器连接的线上服务地址，例如 http://1.2.3.4:8848
WATCH_SERVER_URL=
WATCH_NOTIFY_POLL_SECONDS=15

# ── AI 分析模型配置 ──────────────────────────────────────────
# 当前使用的模型提供商: claude | openai | gemini
AI_PROVIDER=claude

# Claude (Anthropic)
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_MODEL=claude-opus-4-5
CLAUDE_BASE_URL=

# OpenAI (含兼容接口，如 DeepSeek / 本地 Ollama)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=
# DeepSeek-R1 等推理模型建议调大，因为 reasoning_content 会占用大量 token
OPENAI_MAX_TOKENS=16384

# Gemini (Google)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-pro

# ── 独立只读 MCP（未配置时拒绝启动，不影响现有 Web 服务）─────────
# 必须与外部域名一致，不带 /mcp；Tunnel 指向本机 8849
MCP_PUBLIC_URL=https://mcp.example.com
MCP_CLIENT_ID=8848-chatgpt
# 使用 secrets.token_urlsafe(32) 生成，至少32字符；仅填入客户端OAuth配置
MCP_CLIENT_SECRET=
# 复制客户端管理页显示的精确回调地址；多个地址用英文逗号分隔，禁止通配
MCP_REDIRECT_URIS=
# uv run python -m scripts.mcp_admin password-hash 生成（不是密码明文）
MCP_OWNER_PASSWORD_HASH=
# 可选：默认项目根目录 mcp_auth.db，不得与 stock_cache.db 相同
# MCP_AUTH_DB=/absolute/private/path/mcp_auth.db
